        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USERS ||--o{ DEVICES : \&quot;pairs\&quot;\n    USERS ||--o{ REFRESH_TOKENS : \&quot;holds\&quot;\n    USERS ||--o{ RECORDS : \&quot;owns\&quot;\n    USERS ||--o{ PLAYS : \&quot;listens\&quot;\n    USERS ||--o{ TAGS : \&quot;registers\&quot;\n    USERS |o--o{ RELEASES : \&quot;created manually\&quot;\n    RELEASES ||--o{ RECORDS : \&quot;is a copy of\&quot;\n    RELEASES ||--o{ PRICE_SNAPSHOTS : \&quot;priced daily\&quot;\n    RECORDS ||--o| TAGS : \&quot;labelled by\&quot;\n    RECORDS |o--o{ PLAYS : \&quot;played as\&quot;\n    DEVICES |o--o{ PLAYS : \&quot;reports\&quot;\n\n    USERS {\n        bigint user_id PK\n        text idp_subject UK\n        text email\n        timestamptz created_at\n    }\n    REFRESH_TOKENS {\n        bigint token_id PK\n        bigint user_id FK\n        text token_hash UK\n        timestamptz expires_at\n        timestamptz revoked_at\n    }\n    DEVICES {\n        text device_id PK\n        bigint user_id FK\n        text pairing_token_hash UK\n        timestamptz last_seen_at\n        timestamptz revoked_at\n    }\n    RELEASES {\n        bigint release_id PK\n        int discogs_release_id UK\n        bigint created_by_user_id FK\n        text artist\n        text title\n        text label\n        smallint year\n        text_array genres\n        text cover_url\n    }\n    RECORDS {\n        bigint record_id PK\n        bigint user_id FK\n        bigint release_id FK\n        timestamptz added_at\n        timestamptz removed_at\n        text condition\n        text notes\n    }\n    TAGS {\n        bigint user_id PK\n        char14 tag_uid PK\n        bigint record_id FK\n    }\n    PLAYS {\n        bigint play_id PK\n        bigint user_id FK\n        bigint record_id FK\n        text device_id FK\n        char14 tag_uid\n        text event_id\n        timestamptz played_at\n    }\n    PRICE_SNAPSHOTS {\n        bigint release_id PK\n        date snapshot_date PK\n        numeric lowest_price\n        int num_for_sale\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="OoDmp4srDvtjCAPszD1y-1">
